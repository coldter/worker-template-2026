{
  "name": "repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "ultracite check && bun run check:hosts",
    "fix": "ultracite fix",
    "format": "biome format --write",
    "dev": "turbo dev --filter=!@repo/email",
    "build": "turbo build",
    "clean": "rm -rf .turbo && git clean -xdf node_modules apps/*/node_modules && rm bun.lock",
    "check-types": "turbo check-types",
    "check-types:backup": "turbo check-types:backup",
    "dev:admin-ui": "turbo -F admin-ui dev",
    "preview:admin-ui": "turbo -F admin-ui preview",
    "deploy:admin": "turbo -F admin-ui build && turbo -F admin deploy",
    "dev:server": "turbo -F server dev",
    "dev:auth": "turbo -F auth dev",
    "dev:email": "turbo -F @repo/email dev",
    "db:push": "turbo -F @repo/db db:push",
    "db:studio": "turbo -F @repo/db db:studio",
    "db:generate": "turbo -F @repo/db db:generate",
    "db:migrate": "turbo -F @repo/db db:migrate",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "knip": "SKIP_ENV_VALIDATION=true knip -c knip.config.ts",
    "knip:fix": "knip --fix -c knip.config.ts -W apps/admin-ui",
    "setup:env": "bash scripts/setup-env.sh && bun scripts/setup-env.ts",
    "setup:env:hosts": "bun scripts/setup-env.ts",
    "check:hosts": "bun scripts/check-hosts.ts",
    "seed:dev": "cd apps/server && bun ../../scripts/seed-dev.ts",
    "test:scripts": "bun test scripts/__tests__/",
    "update:deps": "bunx taze major -w -r --ignore-other-workspaces --ignore-paths apps/mobile",
    "template:init": "bun scripts/init-template.ts",
    "generate-openapi": "turbo -F server generate-openapi",
    "generate-client": "turbo -F admin-ui generate-client",
    "dev:storybook": "turbo -F admin-ui storybook",
    "build:storybook": "turbo -F admin-ui build-storybook",
    "postinstall": "test -f apps/server/openapi.cache.json || turbo -F server generate-openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "beta",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.11.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3",
    "ultracite": "^7.6.3"
  },
  "packageManager": "bun@1.3.13"
}
