{
  "name": "repo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:storybook": "turbo -F web build-storybook",
    "cf-typegen": "turbo cf-typegen",
    "cf-typegen:check": "turbo cf-typegen:check",
    "check": "ultracite check",
    "typecheck": "turbo typecheck",
    "clean": "rm -rf .turbo node_modules apps/*/node_modules packages/*/node_modules && rm -f bun.lock",
    "db:generate": "turbo -F @repo/db db:generate",
    "db:migrate": "turbo -F @repo/db db:migrate",
    "db:push": "turbo -F @repo/db db:push",
    "db:studio": "turbo -F @repo/db db:studio",
    "deploy:web": "turbo -F web deploy",
    "dev": "turbo dev --filter=!@repo/email",
    "dev:auth": "turbo -F auth dev",
    "dev:email": "turbo -F @repo/email dev",
    "dev:server": "turbo -F server dev",
    "dev:storybook": "turbo -F web storybook",
    "dev:web": "turbo -F web dev",
    "fix": "ultracite fix",
    "format": "oxfmt --write .",
    "generate-client": "turbo -F web generate-client",
    "generate-openapi": "turbo -F server generate-openapi",
    "postinstall": "test -f apps/server/openapi.cache.json || turbo -F server generate-openapi",
    "knip": "knip --no-config-hints -c knip.config.ts",
    "preview:web": "turbo -F web preview",
    "setup:env": "bash scripts/setup-env.sh",
    "template:init": "bun scripts/init-template.ts",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:watch": "turbo test:watch",
    "update:deps": "bunx taze major -w -r --ignore-other-workspaces --ignore-paths apps/mobile",
    "verify:generated": "bun run generate-client && bun run cf-typegen:check && git diff --exit-code -- apps/server/openapi.cache.json apps/web/src/api.gen"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.44.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
