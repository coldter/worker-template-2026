# ===========================
# Server Development Environment
# ===========================
# Runtime vars are configured in wrangler.jsonc (not here).
# This file is only for local tooling (drizzle-kit, seeds, scripts).

# --- Database (for drizzle-kit CLI and seed scripts) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/app_test

# --- Cloudflare Secrets (for local dev, set via .dev.vars or wrangler.jsonc) ---
# Create a .dev.vars file in apps/server/ with:
# BETTER_AUTH_SECRET=dev-secret-change-me
# RESEND_API_KEY=re_test_xxx
# VAULT_MASTER_KEY=dev-vault-key-change-me
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=<base64>
