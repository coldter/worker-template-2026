{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] },
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "types": ["./worker-configuration.d.ts"],
    "noUnusedLocals": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
