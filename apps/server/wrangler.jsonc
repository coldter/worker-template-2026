{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "placeholder-hyperdrive-id",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/app_dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "placeholder-kv-id",
      "preview_id": "placeholder-kv-preview-id"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "server_requests"
    },
    {
      "binding": "PRODUCT_ANALYTICS",
      "dataset": "server_events"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RateLimiter"
      ]
    }
  ],
  "workflows": [
    {
      "name": "onboarding-workflow",
      "binding": "ONBOARDING_WF",
      "class_name": "OnboardingWorkflow"
    },
    {
      "name": "email-notification-workflow",
      "binding": "EMAIL_NOTIFICATION_WF",
      "class_name": "EmailNotificationWorkflow"
    },
    {
      "name": "push-notification-workflow",
      "binding": "PUSH_NOTIFICATION_WF",
      "class_name": "PushNotificationWorkflow"
    }
  ],
  "secrets": {
    "required": [
      "FIREBASE_SERVICE_ACCOUNT_KEY_BASE64",
      "RESEND_API_KEY",
      "VAULT_MASTER_KEY",
      "SSO_KEY",
      // A5 — CF for SaaS (D7). Three permissions, scoped to ONE zone:
      //   Zone:Read, SSL and Certificates:Edit, Custom Hostnames:Edit.
      // NEVER account-wide. Quarterly rotation per runbook.
      "CLOUDFLARE_API_TOKEN"
    ]
  },
  "services": [
    {
      "binding": "AUTH",
      "service": "auth",
      "entrypoint": "AuthEntrypoint"
    },
    // B4 (D40, D45) — apps/app SPA, reachable only via this binding. The
    // catch-all in `src/server.ts` forwards non-`/api/*` requests here.
    {
      "binding": "STATIC_ASSETS",
      "service": "app"
    }
  ],
  "vars": {
    "NODE_ENV": "development",
    "APP_URL": "http://localhost:8787",
    "CORS_ORIGINS": "http://localhost:3001",
    "EMAIL_FROM": "noreply@example.com",
    "APP_NAME": "App",
    "COMPANY_NAME": "Acme Inc.",
    "SUPPORT_EMAIL": "support@example.com",
    "LOGO_TEXT": "App",
    "BRAND_PRIMARY_COLOR": "#2563eb",
    "FCM_PROVIDER": "firebase",
    "WILDCARD_SUFFIX": ".app.lvh.me",
    "ADMIN_HOST": "admin.lvh.me",
    "FALLBACK_HOST": "fallback.lvh.me",
    "LOCAL_DEV_HOSTS": "localhost:3001,localhost:3002",
    // Empty placeholder — B6 wires the per-tenant logo CDN URL.
    "BRANDING_BASE_URL": "",
    // A5 — CF for SaaS (D5, D7, D14).
    "CLOUDFLARE_ZONE_ID": "placeholder-zone-id",
    "CUSTOM_HOST_CNAME_TARGET": "customers.example.test",
    "CUSTOM_HOST_VERIFICATION_LABEL": "_app-example-verify",
    "BRANDING_HOST": "branding.example.test",
  },
  "triggers": {
    // A5 / D9 — 60s reconciler for non-terminal custom hostnames.
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "AUDIT_LOG_QUEUE", "queue": "audit-log-buffer" }
    ],
    "consumers": [
      {
        "queue": "audit-log-buffer",
        "max_batch_size": 100,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "audit-log-dlq"
      }
    ]
  }
}