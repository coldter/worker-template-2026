    "better-auth": "^1.5.6",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "hono": "^4.12.9",
    "pg": "^8.20.0",
    "pg-error-enum": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@faker-js/faker": "^10.4.0",
    "@inquirer/prompts": "^8.3.2",
    "@types/pg": "^8.20.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "drizzle-kit": "^1.0.0-beta.9-e89174b",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.78.0"
  }
