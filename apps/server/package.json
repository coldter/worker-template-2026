{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "dev": "wrangler types --env-interface CloudflareBindings && wrangler dev --inspector-port 9229",
    "start": "wrangler dev",
    "deploy": "wrangler deploy --var NODE_ENV:production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seeds/index.ts",
    "seed:audit-logs": "tsx scripts/seeds/audit-logs/run.ts",
    "vault:debug": "tsx scripts/vault-debug.ts",
    "push:debug": "tsx scripts/push-debug.ts",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "db:mm:up": "drizzle-kit up",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.0",
    "better-auth": "^1.6.15",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "hono": "^4.12.25",
    "pg": "^8.21.0",
    "pg-error-enum": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@faker-js/faker": "^10.4.0",
    "@inquirer/prompts": "^8.5.2",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "beta",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
