{
  "name": "server",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "cf-typegen:check": "wrangler types --check --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seeds/index.ts",
    "deploy": "set -a && . ../../.env && set +a && wrangler deploy --var NODE_ENV:production --var \"APP_URL:${APP_URL:?APP_URL must be set in the root .env}\" --var \"CORS_ORIGINS:${CORS_ORIGINS:?CORS_ORIGINS must be set in the root .env}\"",
    "dev": "wrangler types --env-interface CloudflareBindings && wrangler dev --inspector-port 9229",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "push:debug": "tsx scripts/push-debug.ts",
    "seed:audit-logs": "tsx scripts/seeds/audit-logs/run.ts",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.18",
    "better-auth": "^1.7.18",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "pg-error-enum": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@faker-js/faker": "^10.6.0",
    "@inquirer/prompts": "^8.7.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "chalk": "^6.0.1",
    "cli-highlight": "^2.1.11",
    "drizzle-kit": "1.0.0-rc.5",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
