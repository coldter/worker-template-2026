{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "dev": "bun run generate-client && vite --port=3001",
