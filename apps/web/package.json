    "preview": "vite preview --port=3002",
    "preview:cf": "bun run build && wrangler dev",
    "start": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
