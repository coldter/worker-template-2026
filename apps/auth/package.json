{
  "name": "auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types --env-interface CloudflareBindings && wrangler dev --port 8788 --inspector-port 9230",
    "deploy": "wrangler deploy --minify --var NODE_ENV:production",
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "hono": "^4.12.21",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "beta",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.1"
  }
}
