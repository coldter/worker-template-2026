{
  "name": "auth",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "deploy": "wrangler deploy --var NODE_ENV:production --var ENABLE_SIGNUP:false",
    "dev": "wrangler types --env-interface CloudflareBindings && wrangler dev --port 8788 --inspector-port 9230",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
