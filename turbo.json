{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["bun.lock", ".env"],
  "globalEnv": ["SKIP_ENV_VALIDATION", "DEV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_*", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "../../tsconfig*.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "generate-openapi": {
      "cache": true,
      "outputs": ["openapi.cache.json"],
      "inputs": ["src/**/*.ts"]
    },
    "generate-client": {
      "cache": true,
      "dependsOn": ["^generate-openapi"],
      "outputs": ["src/api.gen/**"],
      "inputs": ["openapi-ts.config.ts", "../server/openapi.cache.json"]
    },
    "test": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_TEST_URL"]
    },
    "test:coverage": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    },
    "storybook": {
      "persistent": true,
      "cache": false
    },
    "build-storybook": {
      "cache": true,
      "outputs": ["storybook-static/**"]
    }
  }
}
