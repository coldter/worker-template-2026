{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["bun.lock"],
  "globalEnv": ["SKIP_ENV_VALIDATION", "DEV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_TEST_URL"]
    },
    "test:coverage": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    }
  }
}
