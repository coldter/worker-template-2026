{
  "name": "@repo/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "dev": "email dev --dir ./src/templates --port 3003",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "^1.0.11",
    "@repo/shared": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "^6.2.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "beta",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
