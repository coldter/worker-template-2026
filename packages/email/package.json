{
  "name": "@repo/email",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration",
    "check-types": "tsc --noEmit",
    "dev": "email dev --dir ./src/templates --port 3003",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@repo/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "resend": "^6.27.0"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
