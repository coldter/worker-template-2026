# =============================================================================
# Root Environment Variables (single source of truth)
# =============================================================================
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# Then generate worker .dev.vars (secrets) and app .env files:
#   bun run setup:env
#
# Non-secret config (NODE_ENV, APP_URL, etc.) lives in wrangler.jsonc vars.
# All commands are run from the repo root. Bun loads .env automatically.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/app_test

# --- Auth (apps/auth secrets) -------------------------------------------------
BETTER_AUTH_SECRET=

# --- Email (apps/server, apps/auth secret + non-secret) -----------------------
RESEND_API_KEY=
# Outbound `From:` address for transactional email. Non-secret; lives in
# wrangler.jsonc `vars` for both apps/server and apps/auth and is overridden
# at deploy time via --var EMAIL_FROM:noreply@your-domain.tld.
EMAIL_FROM=noreply@example.com

# --- Firebase (apps/server secret, push notifications) ------------------------
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
# Provider hint for the push-notification workflow. Currently the only
# supported value is `firebase`. Non-secret; lives in apps/server vars.
FCM_PROVIDER=firebase

# --- Vault (apps/server secret) -----------------------------------------------
VAULT_MASTER_KEY=

# --- SSO encryption (apps/server secret) --------------------------------------
# Used as `app.sso_key` for pgcrypto encryption/decryption of OIDC configs.
SSO_KEY=

# --- Cloudflare for SaaS (apps/server secrets) --------------------------------
# A5 / D7 — token MUST be scoped to a single zone with three permissions:
#   Zone:Read, SSL and Certificates:Edit, Custom Hostnames:Edit.
# NEVER account-wide. Quarterly rotation per runbook.
CLOUDFLARE_API_TOKEN=
# Zone id for the apex hosting tenant custom hostnames (CF for SaaS). The
# server worker reads this to call the CF API.
CLOUDFLARE_ZONE_ID=

# --- Cloudflare Access (apps/admin secrets) -----------------------------------
# CF Access application audience tag (`AUD`). Required for operator console
# verification of the `Cf-Access-Jwt-Assertion` header.
CF_ACCESS_AUD=
# Team domain (e.g. `your-team.cloudflareaccess.com`) used to fetch the
# Access JWKS endpoint.
CF_ACCESS_TEAM_DOMAIN=

# --- apps/admin dev-only ------------------------------------------------------
# When `ALLOW_DEV_ADMIN_AUTH=true` (apps/admin vars block), the admin worker
# accepts requests without a Cf-Access-Jwt-Assertion header in development
# and impersonates the operator identified by this email. Never set in
# production.
LOCAL_DEV_ADMIN_EMAIL=dev-operator@example.com

# --- Brand (server-side display strings) --------------------------------------
APP_NAME=App
COMPANY_NAME="Acme Inc."
SUPPORT_EMAIL=support@example.com
LOGO_TEXT=App
BRAND_PRIMARY_COLOR=#2563eb
APP_URL=http://localhost:8787

# --- Web App ------------------------------------------------------------------
VITE_SERVER_URL=http://localhost:8787

# --- Brand (web build-time display strings) -----------------------------------
VITE_APP_NAME=App
VITE_COMPANY_NAME="Acme Inc."
VITE_SUPPORT_EMAIL=support@example.com
VITE_LOGO_TEXT=App
VITE_BRAND_PRIMARY_COLOR=#2563eb
VITE_APP_URL=http://localhost:3001

# --- Multi-tenant Host Config (Phase 0 spike, locked for Phase A) -------------
# All public hostnames in the design derive from this surface. Change the
# domain by editing these values; do NOT hard-code hosts in worker config.
ROOT_DOMAIN=example.test
APP_WILDCARD_HOST=app.example.test
ADMIN_HOST=admin.example.test
FALLBACK_HOST=fallback.example.test
CUSTOM_HOST_CNAME_TARGET=customers.example.test
CUSTOM_HOST_VERIFICATION_LABEL=_app-example-verify
BRANDING_HOST=branding.example.test

# Local host-accurate harness (mkcert + reverse proxy)
LOCAL_APP_WILDCARD_HOST=app.lvh.me
LOCAL_ADMIN_HOST=admin.lvh.me
LOCAL_FALLBACK_HOST=fallback.lvh.me
LOCAL_TLS_PORT=8443
DEFAULT_DEV_TENANT_SLUG=acme
DEFAULT_DEV_CUSTOM_HOST=app.acme.local.test
ALLOW_DEV_TENANT_HEADER=true
ALLOW_DEV_TENANT_AUTH=false

# --- Seed dev (Phase A) -------------------------------------------------------
# `bun run seed:dev` provisions a baseline tenant for local development. The
# password runs through Better Auth's scrypt path so the resulting user can
# sign in via the email/password flow. The custom-hostname row is optional.
LOCAL_DEV_TENANT_EMAIL=owner@acme.test
LOCAL_DEV_TENANT_PASSWORD=changeme123
