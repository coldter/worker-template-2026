# ===========================
# Production Environment
# ===========================
# These vars are set via wrangler.jsonc or Cloudflare dashboard.
# This file documents what is needed for production deployment.

# --- Cloudflare Wrangler Vars ---
APP_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=App
FCM_PROVIDER=console

# --- Cloudflare Secrets (set via `wrangler secret put`) ---
# BETTER_AUTH_SECRET=<random-secret>
# RESEND_API_KEY=<resend-api-key>
# VAULT_MASTER_KEY=<random-secret>
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=<base64-encoded-json>

# --- Cloudflare Bindings (set via wrangler.jsonc or dashboard) ---
# HYPERDRIVE: configured in wrangler.jsonc with Hyperdrive ID
# CACHE: KV namespace configured in wrangler.jsonc
# ANALYTICS / PRODUCT_ANALYTICS: Analytics Engine datasets

# --- Local Tooling (drizzle-kit, seeds) ---
# These are used by CLI scripts running under Node.js, not the Worker runtime
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Web App ---
VITE_SERVER_URL=https://your-domain.com
